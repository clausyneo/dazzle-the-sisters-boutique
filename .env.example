DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dazzle_boutique
PORT=3000
NODE_ENV=development
DB_SSL_CA_PATH=

# Browser origins allowed to call the backend (comma-separated)
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
ADMIN_FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Brevo transactional email API (recommended for Render Free)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME="Dazzle the Sister's Boutique"

# Required for password reset links
FRONTEND_BASE_URL=http://127.0.0.1:5500/frontend/

# Optional legacy SMTP fallback for environments that allow SMTP connections
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="Dazzle Boutique <no-reply@example.com>"
